# ========================================================
# Smart Village Digital Tele-Health Dispensary Environment
# ========================================================

# 1. Centralized Backend Server Configuration
PORT=3001
NODE_ENV=production

# 2. Frontend Backend URL
# Set this to the public URL of your deployed backend server (e.g., Render, Railway, Fly.io)
# Or set to your host computer's local Wi-Fi IPv4 address when testing on local LAN (e.g., http://192.168.1.15:3001)
VITE_BACKEND_URL=https://smart-village-digital-tele-health-7kzs.onrender.com

# 3. Agora Video & Audio RTC Configuration (Server Secrets)
# Never commit your App Certificate to client code or repositories
AGORA_APP_ID=aab8b3f972274fcb87cc25048d089e94
AGORA_APP_CERTIFICATE=vm-telehealth-dispensary-secure-key-2026
# Optional static or wildcard test token:
# AGORA_TOKEN=

# 4. TURN Server Configuration (Required for real-time video/audio on Render/cloud deployments)
# Without TURN relay, WebRTC will FAIL when both peers are behind NAT firewalls or Render's proxy.
# Free TURN providers: https://www.metered.ca/tools/openrelay/ (demo) or https://www.metered.ca/ (production)
# Set these in your Render dashboard → Environment Variables.
# Leave blank to use the free OpenRelay fallback (rate-limited, for demo only).
TURN_HOST=global.relay.metered.ca
TURN_USERNAME=
TURN_CREDENTIAL=

